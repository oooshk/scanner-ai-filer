[Unit]
Description=Scanner AI Document Filer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/scanner
Environment=PYTHONPATH=/home/pi/scanner/src
ExecStart=/home/pi/scanner/.venv/bin/python -m scanner_filer.cli --config /home/pi/scanner/config.yaml watch
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
