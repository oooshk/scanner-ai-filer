[Unit]
Description=Scanner AI Document Filer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{SCANNER_USER}}
WorkingDirectory={{SCANNER_DIR}}
Environment=PYTHONPATH={{SCANNER_DIR}}/src
ExecStart={{PYTHON_BIN}} -m scanner_filer.cli --config {{CONFIG_PATH}} watch
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
