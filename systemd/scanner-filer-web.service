[Unit]
Description=Scanner Filer Web UI
After=network-online.target scanner-filer.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/scanner
Environment=PYTHONPATH=/home/pi/scanner/src
Environment=SCANNER_WEB_USER=admin
Environment=SCANNER_WEB_PASSWORD=
Environment=SCANNER_WEB_ENABLE_SETUP=true
Environment=SCANNER_WEB_SECURE_COOKIE=false
# LAN-only allowlist: localhost + RFC1918 home subnet.
Environment=SCANNER_WEB_ALLOWED_NETS=127.0.0.1/32,192.168.1.0/24
Environment=SCANNER_WEB_DISABLE_AUTH=false
ExecStart=/home/pi/scanner/.venv/bin/python -m scanner_filer.web --config /home/pi/scanner/config.yaml --host 192.168.1.78 --port 8090
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
