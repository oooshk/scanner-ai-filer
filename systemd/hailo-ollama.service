[Unit]
Description=Hailo-Ollama API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{SCANNER_USER}}
WorkingDirectory={{SCANNER_HOME}}
Environment=HOME={{SCANNER_HOME}}
Environment=XDG_CONFIG_HOME={{SCANNER_HOME}}/.config
Environment=XDG_DATA_HOME={{SCANNER_HOME}}/.local/share
ExecStart={{HAILO_OLLAMA_BIN}}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target