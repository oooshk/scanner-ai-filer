# Copy this file to /etc/default/scanner-email-intake-web and set real values.
# Permissions should be root-owned and mode 600.

# Microsoft app credentials used by Quick Connect Outlook in the bolt-on UI.
SCANNER_EMAIL_MS_CLIENT_ID="your-azure-app-client-id"
SCANNER_EMAIL_MS_CLIENT_SECRET="your-azure-app-client-secret"
# Microsoft tenant selector for OAuth endpoints: common | consumers | organizations | <tenant-id>
# For personal Outlook/Hotmail accounts, set this to consumers.
SCANNER_EMAIL_MS_TENANT="consumers"

# Optional explicit callback override (normally auto-detected from request host).
SCANNER_EMAIL_OAUTH_REDIRECT_URI="http://localhost:8091/oauth2/callback"

# Optional secure cookie setting when serving over HTTPS.
# SCANNER_WEB_SECURE_COOKIE="true"

# Shared login session across Scanner UI and Email Intake UI.
# Keep these aligned with the scanner web service environment.
# If SCANNER_WEB_SECRET is set here and in scanner service, logging in once covers both UIs.
# SCANNER_WEB_SECRET="set-a-long-random-secret"
# SCANNER_WEB_SESSION_COOKIE="scanner_session"
