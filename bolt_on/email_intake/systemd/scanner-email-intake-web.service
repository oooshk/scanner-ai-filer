[Unit]
Description=Scanner Email Intake Bolt-On Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/scanner
EnvironmentFile=-/etc/default/scanner-email-intake-web
ExecStart=/usr/bin/python3 /home/pi/scanner/bolt_on/email_intake/web_ui.py --config /home/pi/scanner/bolt_on/email_intake/config.yaml --host 0.0.0.0 --port 8091
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
